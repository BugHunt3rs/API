generator client {
  provider = "prisma-client"
  output   = "../infrastructure/database/orm/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model cargo_status {
  id             Int              @id @default(autoincrement())
  description    String           @db.VarChar(255)
  create_date    DateTime         @default(now()) @db.Date
  chemical_cargo chemical_cargo[]
}

model chemical {
  id             Int              @id @default(autoincrement())
  name           String           @db.VarChar(255)
  Description    String           @db.VarChar(255)
  UN_number      String           @db.VarChar(4)
  risk_class_id  Int
  status         Boolean
  create_date    DateTime         @default(now()) @db.Date
  update_date    DateTime         @default(now()) @db.Date
  risk_class     risk_class       @relation(fields: [risk_class_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  chemical_cargo chemical_cargo[]
}

model chemical_cargo {
  id                                                                                   Int                    @id @default(autoincrement())
  cargo_code                                                                           String                 @db.VarChar(255)
  chemical_id                                                                          Int
  quantity                                                                             BigInt
  measure_unity_id                                                                     Int
  origin                                                                               String                 @db.VarChar(255)
  destination                                                                          String                 @db.VarChar(255)
  tecnical_manager                                                                     Int
  required_documentation                                                               Int
  status                                                                               Int
  delivery_date                                                                        DateTime               @db.Date
  create_date                                                                          DateTime               @default(now()) @db.Date
  update_date                                                                          DateTime               @default(now()) @db.Date
  chemical                                                                             chemical               @relation(fields: [chemical_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  measure_unity                                                                        measure_unity          @relation(fields: [measure_unity_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  required_documentation_chemical_cargo_required_documentationTorequired_documentation required_documentation @relation("chemical_cargo_required_documentationTorequired_documentation", fields: [required_documentation], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cargo_status                                                                         cargo_status           @relation(fields: [status], references: [id], onDelete: NoAction, onUpdate: NoAction)
  technical_manager                                                                    technical_manager      @relation(fields: [tecnical_manager], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model logs {
  id   Int  @id @default(autoincrement())
  data Json @db.Json
}

model measure_unity {
  id             Int              @id @default(autoincrement())
  description    String           @db.VarChar(255)
  create_date    DateTime         @default(now()) @db.Date
  chemical_cargo chemical_cargo[]
}

model required_documentation {
  id                                                                           Int              @id @default(autoincrement())
  description                                                                  String           @db.VarChar(255)
  create_date                                                                  DateTime         @default(now()) @db.Date
  chemical_cargo_chemical_cargo_required_documentationTorequired_documentation chemical_cargo[] @relation("chemical_cargo_required_documentationTorequired_documentation")
}

model risk_class {
  id          Int        @id @default(autoincrement())
  description String     @db.VarChar(255)
  create_date DateTime   @default(now()) @db.Date
  chemical    chemical[]
}

model technical_manager {
  id             Int              @id @default(autoincrement())
  name           String           @db.VarChar(255)
  create_date    DateTime         @default(now()) @db.Date
  chemical_cargo chemical_cargo[]
}
