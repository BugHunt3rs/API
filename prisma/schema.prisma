generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model cargo_status {
  id             Int              @id @default(autoincrement())
  description    String           @db.VarChar(255)
  create_date    DateTime         @default(now()) @db.Timestamp(6)
  chemical_cargo chemical_cargo[]
}

model chemical {
  id             Int              @id @default(autoincrement())
  name           String           @db.VarChar(255)
  description    String           @db.VarChar(255)
  UN_number      String           @db.VarChar(4)
  risk_class_id  Int
  status         Boolean
  create_date    DateTime         @default(now()) @db.Timestamp(6)
  update_date    DateTime         @default(now()) @db.Timestamp(6)
  risk_class     risk_class       @relation(fields: [risk_class_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  chemical_cargo chemical_cargo[]
}

model chemical_cargo {
  id                        Int                    @id @default(autoincrement())
  cargo_code                String                 @db.VarChar(255)
  chemical_id               Int
  quantity                  BigInt
  measure_unity_id          Int
  origin                    String                 @db.VarChar(255)
  destination               String                 @db.VarChar(255)
  technical_manager_id      Int
  required_documentation_id Int
  status_id                 Int
  delivery_date             DateTime               @db.Date
  create_date               DateTime               @default(now()) @db.Timestamp(6)
  update_date               DateTime               @default(now()) @db.Timestamp(6)
  chemical                  chemical               @relation(fields: [chemical_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  measure_unity             measure_unity          @relation(fields: [measure_unity_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  required_documentation    required_documentation @relation(fields: [required_documentation_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "chemical_cargo_required_documentation_fkey")
  cargo_status              cargo_status           @relation(fields: [status_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "chemical_cargo_status_fkey")
  technical_manager         technical_manager      @relation(fields: [technical_manager_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "chemical_cargo_tecnical_manager_fkey")
}

model logs {
  id   Int      @id @default(autoincrement())
  data Json     @db.Json
  date DateTime @default(now()) @db.Timestamp(6)
}

model measure_unity {
  id             Int              @id @default(autoincrement())
  description    String           @db.VarChar(255)
  create_date    DateTime         @default(now()) @db.Timestamp(6)
  chemical_cargo chemical_cargo[]
}

model required_documentation {
  id             Int              @id @default(autoincrement())
  description    String           @db.VarChar(255)
  create_date    DateTime         @default(now()) @db.Timestamp(6)
  chemical_cargo chemical_cargo[]
}

model risk_class {
  id          Int        @id @default(autoincrement())
  description String     @db.VarChar(255)
  create_date DateTime   @default(now()) @db.Timestamp(6)
  chemical    chemical[]
}

model technical_manager {
  id             Int              @id @default(autoincrement())
  name           String           @db.VarChar(255)
  create_date    DateTime         @default(now()) @db.Timestamp(6)
  chemical_cargo chemical_cargo[]
}
